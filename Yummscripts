-- Functions
local function CopyToClipboard(text)
    if text and text ~= "" then
        setclipboard(text)
        CopyButton.Text = "✅ Copied!"
        task.wait(1.5)
        CopyButton.Text = "📋 Copy Link"
    end
end

local function CheckKey()
    local inputKey = KeyBox.Text
    if inputKey == "" then
        KeyBox.PlaceholderText = "❌ Please enter a key!"
        KeyBox.BorderColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.5)
        KeyBox.PlaceholderText = "Enter key..."
        KeyBox.BorderColor3 = Color3.fromRGB(255, 100, 150)
        return
    end
    
    -- Here you would normally make an HTTP request to verify the key
    -- For example using HttpService
    print("Checking key: " .. inputKey)
    -- Your key verification logic here
    
    -- Example validation (replace with actual HTTP request)
    if inputKey == "YummKey123" then -- Example valid key
        KeyBox.BorderColor3 = Color3.fromRGB(50, 255, 100)
        CheckButton.Text = "✅ Valid Key!"
        task.wait(2)
        CheckButton.Text = "✅ Check Key"
        KeyBox.BorderColor3 = Color3.fromRGB(255, 100, 150)
        -- Open HUB or grant access
        print("Key accepted! Loading HUB...")
    else
        KeyBox.BorderColor3 = Color3.fromRGB(255, 50, 50)
        CheckButton.Text = "❌ Invalid Key"
        task.wait(2)
        CheckButton.Text = "✅ Check Key"
        KeyBox.BorderColor3 = Color3.fromRGB(255, 100, 150)
    end
end

-- Button connections
CheckButton.MouseButton1Click:Connect(CheckKey)

CopyButton.MouseButton1Click:Connect(function()
    CopyToClipboard(API_LINK)
end)

-- Also copy when clicking the link display
LinkDisplay.MouseButton1Click:Connect(function()
